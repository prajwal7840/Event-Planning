{
  "name": "event-planning-api",
  "version": "1.0.0",
  "description": "REST API for Event Planning and Management Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "e2e": "node scripts/e2e/run.js",
    "loadtest": "node loadtest/console/server.js",
    "loadtest:install": "node loadtest/tools/install-k6.js",
    "loadtest:50": "node loadtest/cli.js --config loadtest/profiles/50-users.json --confirm managed-local",
    "loadtest:smoke": "node loadtest/cli.js --preset smoke --confirm managed-local",
    "loadtest:test": "node --test \"loadtest/test/*.test.js\"",
    "seed:marketplace": "node scripts/seed-sample-marketplace.js",
    "seed:demo": "npm run seed:marketplace && node scripts/seed-demo-data.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "swagger-ui-dist": "^5.34.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "playwright-core": "^1.64.1"
  }
}
